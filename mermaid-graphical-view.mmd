flowchart TD
    %% Icons are Font Awesome (fa:fa-...). Mermaid Live / Mermaid Chart show them;
    %% viewers without Font Awesome show the text only.

    %% ---------- 1. One-time setup ----------
    subgraph Setup["1 · One-time setup"]
        S1("fa:fa-puzzle-piece <b>Install the browser extension<br/>(Brave or Chrome)")
        S2("fa:fa-key <b>OPTIONAL</b> fa:fa-key\n run the save-login launcher.<br/>CWL login can be stored encrypted<br/>in Windows Credential Manager<br/>or the macOS Keychain.")
    end
    
    %% ---------- 2. Starting ----------
    Start(["fa:fa-play <b>Starting</b>: Double-click the \n run-keepalive launcher"])
    Start ==> Prep("fa:fa-terminal Shows the startup notes:<br/>log folder, saved login,<br/>keeping the computer awake,<br/>how to stop")
    %% Start --> Busy
    
    %% ---------- 3. Browser ----------
    subgraph Browser["2 · Your browser"]
        B0("fa:fa-user Log in to Elentra as usual")
        B1("fa:fa-sync The extension will check <br/> your login state")
        B2("fa:fa-cookie-bite Sends the temporary Elentra<br/>session cookie to the script")
        B3("fa:fa-info-circle Toolbar badge:<br/>😎&nbsp;=&nbsp;logged&nbsp;in<br/>🫠&nbsp;=&nbsp;awaiting&nbsp;login<br/>💀&nbsp;=&nbsp;not&nbsp;running")
        B0 --> B1 --> B2
    end
    
    B2 ==>|"sent to 127.0.0.1"| Have
    Prep ==> Have
    
    %% ---------- 4. Main loop ----------
    subgraph Loop["3 · The script's routine"]
        Have{"Has the extension<br/>sent a cookie?"}
        Have ==>|"Not yet"| NoExt("fa:fa-clock Waiting for you<br/>to log in. Checks again<br/>when a cookie arrives.")
        Have ==>|"Yes"| Ping("fa:fa-heartbeat Opens the Elentra dashboard<br/>with your cookie")
        Ping --> Res{"What did<br/>Elentra say?"}
        Res -->|"No answer?"| Err("fa:fa-wifi Try again in 30 seconds")
        Res ==>Alive("fa:fa-check-circle Logged in<br/>Ping again in ~15 min")
        Res ==>Dead("fa:fa-sign-out-alt Logged out")
        Wake("fa:fa-sun Computer just woke up:<br/>check right away")
    end
    
    Dead ==> Busy
    Wake -.-> Ping
    
    %% ---------- 5. Background re-login ----------
    subgraph Relogin["4 · The Auto login system"]
        Busy{"Check: is the CWL<br/> login page open?"}
        Busy -->|"Yes"| LetYou("fa:fa-user-clock Waits until you finish,<br/>then back to routine ↻")
        Busy -->|"No"| Attempts{"Have we exhausted any <br/>previous login attempts?"}
        Attempts -.->|"Yes"| Ask("fa:fa-hand-paper <b>You must log in manually</b><br/>in the browser. The script<br/>will resume automatically.")
        Attempts -->|"No"| Tab("fa:fa-window-restore Extension opens Elentra<br/>in a background tab")
        Tab --> Signed{"Are you already signed in?<br/>(CWL session still valid)"}
        
        Signed -->|"No"| Saved{"Is login saved locally?"}
        Saved -->|"Yes"| Fill("fa:fa-keyboard Fills in and submits<br/>the CWL login form<br/>automatically")
        Saved -->|"No"| Ask
        Fill -->|"Success"| Back("fa:fa-check-circle Back in. Tab closes;<br/>the routine carries on.")
        Fill -->|"Failure"| Ask
    
        Signed -->Back
        Tab ~~~ Fill
    end


​    
    Setup ~~~ Browser 
    Start ~~~ B1
    
    S1 ==> B0
    
