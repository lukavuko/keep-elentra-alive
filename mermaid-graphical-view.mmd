    class S1,S2,Prep,B0,B1,B2,B3,NoExt,Ping,Err,Wake,LetYou,Tab,Fill step
    class Have,Res,Busy,Attempts,Signed,Saved decide
    class Alive,Back good
    class Dead bad
    class Ask warn
    class Start start
    
    style Setup fill:#eef3fb,stroke:#5b7db1,stroke-width:2px,color:#1a3a6b
