---
title: How Elentra Keepalive keeps you logged in
config:
  theme: base
  themeVariables:
    fontFamily: "Segoe UI, Helvetica Neue, Arial, sans-serif"
    fontSize: 15px
    background: "#ffffff"
    primaryColor: "#ffffff"
    primaryTextColor: "#1b1f24"
    primaryBorderColor: "#546e7a"
    lineColor: "#546e7a"
    textColor: "#1b1f24"
    titleColor: "#1b1f24"
    clusterBkg: "#f6f8fa"
    clusterBorder: "#90a4ae"
    edgeLabelBackground: "#ffffff"
  flowchart:
    htmlLabels: true
    wrappingWidth: 240
    padding: 16
    nodeSpacing: 45
    rankSpacing: 55
    subGraphTitleMargin:
      top: 6
      bottom: 10
---
flowchart TD
    %% ---------- 1. One-time setup ----------
    subgraph Setup["1 &nbsp;One-time setup"]
        S1["Install the browser extension<br/>(Brave or Chrome)"]
        S2["Optional: run the save-login launcher.<br/>Your CWL login is stored encrypted in<br/>Windows Credential Manager<br/>or the macOS Keychain."]
    end

    %% ---------- 2. Starting ----------
    Start(["2 &nbsp;Double-click the run-keepalive launcher"])
    Start --> Prep["Shows the startup notes:<br/>log folder, saved login,<br/>keeping the computer awake,<br/>how to stop"]

    %% ---------- 3. Browser ----------
    subgraph Browser["3 &nbsp;Your browser"]
        B0["You log in to Elentra as usual"]
        B1["The extension checks in:<br/>when your login changes,<br/>every minute, on wake-up,<br/>on browser start, or on icon click"]
        B2["Sends only the Elentra<br/>session cookie to the script<br/>(never your password)"]
        B3["Toolbar badge:<br/>ON = logged in<br/>... = waiting for a login<br/>OFF = script not running"]
        B0 --> B1 --> B2
    end

    B2 -->|"sent to 127.0.0.1"| Have
    Prep --> Have

    %% ---------- 4. Main loop ----------
    subgraph Loop["4 &nbsp;The script's routine (repeats until closed)"]
        Have{"Has the extension<br/>sent a cookie?"}
        Have -->|"Not yet"| NoExt["Shows: Waiting for you<br/>to log in"]
        Have -->|"Yes"| Ping["Opens the Elentra dashboard<br/>with your cookie"]
        Ping --> Res{"What did<br/>Elentra say?"}
        Res -->|"Page loaded"| Alive["Still logged in.<br/>Checks again in<br/>about 15 minutes."]
        Res -->|"No answer"| Err["Retries in 30 s,<br/>waiting longer each time<br/>(at most 5 min)"]
        Res -->|"Sent to login"| Dead["Logged out<br/>(usually after sleep)"]
        Wake["Computer just woke up:<br/>check right away"]
    end

    Alive --> Have
    Err --> Have
    NoExt --> Have
    Wake -.-> Ping

    %% ---------- 5. Background re-login ----------
    subgraph Relogin["5 &nbsp;Automatic re-login in a background tab"]
        Busy{"Are you on the<br/>CWL login page<br/>yourself?"}
        Busy -->|"Yes"| LetYou["Waits until<br/>you finish"]
        Busy -->|"No"| Tries{"Tries left?<br/>(now, +2 min, +5 min)"}
        Tries -->|"No"| Ask["Asks you to log in<br/>in the browser"]
        Tries -->|"Yes"| Tab["Extension opens Elentra<br/>in a background tab"]
        Tab --> Page{"What loads<br/>in the tab?"}
        Page -->|"Elentra, signed in"| Back["Back in.<br/>Tab closes, keepalive<br/>carries on."]
        Page -->|"Elentra sign-in page"| Click["Clicks the<br/>CWL login button"]
        Click --> Page
        Page -->|"CWL login form"| Saved{"Login saved?"}
        Saved -->|"No"| Ask
        Saved -->|"Yes"| Fill["Fills it in and submits,<br/>only on the real<br/>UBC login site"]
        Fill --> Page
        Page -->|"Form returns after<br/>the password"| Wrong["Login rejected.<br/>Stops so CWL can't lock<br/>your account; autofill off<br/>until you save it again."]
        Page -->|"Nothing for 90 s<br/>(e.g. MFA)"| Timeout["Gives up this try<br/>and closes the tab"]
        Wrong --> Ask
        Timeout --> Tries
    end

    Dead --> Busy
    LetYou --> Have
    Back --> Have

    %% ---------- Logs ----------
    Logs[("Daily log file: every ping and<br/>every re-login request with its<br/>response (kept 14 days by default)")]
    Loop -.-> Logs
    Relogin -.-> Logs

    S1 -.-> B0
    S2 -.-> Saved

    %% ---------- Colours: dark text on light fills, readable in light and dark viewers ----------
    classDef step fill:#ffffff,stroke:#546e7a,stroke-width:1.5px,color:#1b1f24
    classDef decide fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px,color:#0d2a4a
    classDef good fill:#d7f0d8,stroke:#2e7d32,stroke-width:2px,color:#123d16
    classDef bad fill:#fbdcdc,stroke:#c62828,stroke-width:2px,color:#4a0d0d
    classDef warn fill:#ffefc2,stroke:#b8860b,stroke-width:2px,color:#3d2c00
    classDef start fill:#263238,stroke:#263238,color:#ffffff,font-weight:bold
    classDef log fill:#eceff1,stroke:#546e7a,color:#1b1f24

    class S1,S2,Prep,B0,B1,B2,B3,NoExt,Ping,Err,Wake,LetYou,Tab,Click,Fill,Timeout step
    class Have,Res,Busy,Tries,Page,Saved decide
    class Alive,Back good
    class Dead,Wrong bad
    class Ask warn
    class Start start
    class Logs log

    style Setup fill:#eef3fb,stroke:#5b7db1,stroke-width:1.5px,color:#1b1f24
    style Browser fill:#f4ecfb,stroke:#8a5bb1,stroke-width:1.5px,color:#1b1f24
    style Loop fill:#eef8ee,stroke:#4a9a4a,stroke-width:1.5px,color:#1b1f24
    style Relogin fill:#fff8e6,stroke:#c9a23a,stroke-width:1.5px,color:#1b1f24
