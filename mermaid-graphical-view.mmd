    end

    %% ---------- Starting ----------
    Start(["② Double-click the <b>run-keepalive</b> launcher"])
    Start --> Prep["Stops the computer from dozing off on its own<br/>and opens a private 'mailbox' that only<br/>this computer can talk to"]

    %% ---------- Browser side ----------
    subgraph Browser["③ Your browser"]
        B0["You log in to Elentra as usual"]
        B1["The extension checks in with the script:<br/>• whenever your Elentra login changes<br/>• every minute<br/>• when the computer wakes up<br/>• when the browser starts<br/>• when you click its icon"]
        B2["Hands over <b>only</b> the Elentra login cookie<br/>(the 'you're signed in' ticket)<br/>— never your password"]
        B3["Toolbar badge shows the status:<br/>🟢 ON = logged in<br/>🟡 … = waiting for a login<br/>⚪ OFF = script not running"]
        B0 --> B1 --> B2
    end

    B2 -->|"delivered to the mailbox"| Have
    Prep --> Have

    %% ---------- Main loop ----------
    subgraph Loop["④ The script's routine (repeats until you close it)"]
        Have{"Has the extension<br/>sent a login ticket?"}
        Have -->|"Not yet"| NoExt["Shows: 'Waiting for you to log in'<br/>(or 'is the extension enabled?')"]
        Have -->|"Yes"| Ping["Quietly opens the Elentra dashboard<br/>using your ticket — just like a click would"]
        Ping --> Res{"What did Elentra say?"}
        Res -->|"Page loaded"| Alive["✅ Still logged in<br/>Waits ~15 minutes (plus a random few minutes)<br/>then checks again"]
        Res -->|"No answer<br/>(Wi-Fi down / Elentra busy)"| Err["Tries again in 30 s, then waits<br/>a little longer each time (max 5 min)"]
        Res -->|"Sent to the login page"| Dead["❌ Logged out<br/>(usually after the laptop slept)"]
        Wake["💤 Computer just woke up?<br/>→ check straight away"]
    end

    Alive --> Have
    Err --> Have
    NoExt --> Have
    Wake -.-> Ping

    %% ---------- Background re-login ----------
    subgraph Relogin["⑤ Automatic re-login (in the background)"]
        Busy{"Are you already on the<br/>CWL login page yourself?"}
        Busy -->|"Yes"| LetYou["Stays out of your way<br/>until you finish"]
        Busy -->|"No"| Tries{"Any tries left?<br/>Up to 3: right away,<br/>after 2 min, after 5 min"}
        Tries -->|"No"| Ask["⚠️ Asks you to log in<br/>yourself in the browser"]
        Tries -->|"Yes"| Tab["Extension opens Elentra in a<br/>hidden background tab"]
        Tab --> Page{"What shows up in that tab?"}
        Page -->|"Elentra, already signed in<br/>(UBC sign-on still valid)"| Back["✅ Back in — tab closes,<br/>keepalive carries on"]
        Page -->|"Elentra's sign-in page"| Click["Clicks the CWL login button"]
        Click --> Page
        Page -->|"CWL login form"| Saved{"Did you save your<br/>CWL login?"}
        Saved -->|"No"| Ask
        Saved -->|"Yes"| Fill["Fills it in and submits<br/>— only on the real UBC login site"]
        Fill --> Page
        Page -->|"Login form comes back<br/>after the password was sent"| Wrong["🔒 Login was rejected<br/>Stops immediately so your CWL account<br/>can't get locked; auto-fill stays off<br/>until you run save-login again"]
        Page -->|"Nothing happens for 90 s<br/>(e.g. a two-factor prompt)"| Timeout["Gives up this try, closes the tab"]
        Wrong --> Ask
        Timeout --> Tries
    end

    Dead --> Busy
    LetYou --> Have
    Back --> Have

